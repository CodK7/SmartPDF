{
  "name": "smartpdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#pdf-local-renderer": {
      "development": "./src/infrastructure/pdf/pdf-service.local.ts",
      "default": "./src/infrastructure/pdf/pdf-service.unavailable.ts"
    }
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "generate:pdf-fonts": "node scripts/generate-pdf-fonts.mjs",
    "prebuild": "pnpm generate:pdf-fonts",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "verify:cloudflare": "node scripts/verify-cloudflare-build.mjs && wrangler deploy --dry-run --outdir .cloudflare-dry-run",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview --remote --env preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:motion": "node scripts/motion-audit.mjs",
    "audit:qa": "node scripts/qa-audit.mjs",
    "audit:preview-security": "node scripts/preview-security-audit.mjs",
    "audit:security": "node scripts/security-scan.mjs && pnpm audit --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.14",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "playwright-core": "^1.64.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  },
  "packageManager": "pnpm@11.19.0"
}
