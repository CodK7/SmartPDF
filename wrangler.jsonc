{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartpdf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "PDF_EXPORT_ENABLED": "0"
  },
  "ratelimits": [
    {
      "name": "PDF_EXPORT_IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "PDF_EXPORT_ROUTE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "smartpdf-preview",
      "browser": {
        "binding": "BROWSER"
      },
      "vars": {
        "PDF_EXPORT_ENABLED": "1"
      },
      "ratelimits": [
        {
          "name": "PDF_EXPORT_IP_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 8, "period": 60 }
        },
        {
          "name": "PDF_EXPORT_ROUTE_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  }
}
